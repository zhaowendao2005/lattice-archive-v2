{
  "name": "lattice-archive",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "preinstall": "node scripts/platform.mjs sync-policy",
    "postinstall": "pnpm --dir electron install",
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "platform:info": "node scripts/platform.mjs info",
    "platform:doctor": "node scripts/platform.mjs doctor",
    "platform:sync-policy": "node scripts/platform.mjs sync-policy",
    "cap:sync": "npx cap sync @capawesome/capacitor-electron",
    "electron:build": "pnpm --dir electron run build",
    "electron:rebuild-sqlite": "pnpm --dir electron exec electron-rebuild -f -w better-sqlite3",
    "electron:run": "npx cap run @capawesome/capacitor-electron",
    "electron:pack": "node scripts/platform.mjs pack",
    "electron:pack:mac": "node scripts/platform.mjs pack --target=mac",
    "electron:pack:win": "node scripts/platform.mjs pack --target=win",
    "electron:pack:linux": "node scripts/platform.mjs pack --target=linux",
    "ios:cloud-build": "node scripts/cloud-build-ios.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@lucide/vue": "^1.52.0",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "grid-layout-plus": "^1.1.1",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.0.3",
    "reka-ui": "^2.11.0",
    "shadcn-vue": "^2.8.2",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@capawesome/capacitor-electron": "^0.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  }
}
